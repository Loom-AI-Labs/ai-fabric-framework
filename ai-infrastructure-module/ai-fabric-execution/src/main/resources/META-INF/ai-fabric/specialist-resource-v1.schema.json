{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-fabric.dev/schemas/specialist-resource-v1.schema.json",
  "title": "AI Fabric Specialist Resource V1",
  "description": "Authoring schema for one AI Fabric specialist, bounded specialist chain, JSON Schema, or prompt-profile resource.",
  "oneOf": [
    {
      "$ref": "#/$defs/specialist"
    },
    {
      "$ref": "#/$defs/schemaResource"
    },
    {
      "$ref": "#/$defs/promptProfile"
    },
    {
      "$ref": "#/$defs/specialistChain"
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$"
    },
    "exactRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}@[A-Za-z0-9][A-Za-z0-9._-]{0,39}$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "nameList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "exactRefList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exactRef"
      }
    },
    "resourceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "specialistMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "displayName",
        "description"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "$ref": "#/$defs/boundedText"
        },
        "labels": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9.-]{0,62}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "specialist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "const": "ai.fabric/v1"
        },
        "kind": {
          "const": "Specialist"
        },
        "metadata": {
          "$ref": "#/$defs/specialistMetadata"
        },
        "spec": {
          "$ref": "#/$defs/specialistSpec"
        }
      }
    },
    "specialistSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "instructions",
        "execution",
        "capabilities",
        "input",
        "grounding",
        "output",
        "conversation",
        "limits"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "instructions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objective",
            "promptProfileRef"
          ],
          "properties": {
            "objective": {
              "$ref": "#/$defs/boundedText"
            },
            "promptProfileRef": {
              "$ref": "#/$defs/exactRef"
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "writePolicy"
          ],
          "properties": {
            "strategy": {
              "enum": [
                "SINGLE_PASS",
                "BOUNDED_ITERATIVE"
              ]
            },
            "writePolicy": {
              "enum": [
                "DISABLED",
                "CONFIRMATION_RECEIPT_REQUIRED"
              ]
            }
          }
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "grounding": {
          "$ref": "#/$defs/grounding"
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "conversation": {
          "$ref": "#/$defs/conversation"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution": {
                "properties": {
                  "writePolicy": {
                    "const": "DISABLED"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "properties": {
                  "actions": {
                    "properties": {
                      "proposableWrites": {
                        "maxItems": 0
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution": {
                "properties": {
                  "writePolicy": {
                    "const": "CONFIRMATION_RECEIPT_REQUIRED"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "capabilities": {
                "properties": {
                  "actions": {
                    "properties": {
                      "proposableWrites": {
                        "minItems": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval",
        "actions"
      ],
      "properties": {
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "vectorSpaces"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "vectorSpaces": {
              "$ref": "#/$defs/nameList"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "vectorSpaces": {
                    "minItems": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "vectorSpaces": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visible",
            "requestableReads",
            "proposableWrites"
          ],
          "properties": {
            "visible": {
              "$ref": "#/$defs/nameList"
            },
            "requestableReads": {
              "$ref": "#/$defs/nameList"
            },
            "proposableWrites": {
              "$ref": "#/$defs/nameList"
            }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaRef",
        "rendering",
        "primaryTextPointer",
        "contextPointers"
      ],
      "properties": {
        "schemaRef": {
          "$ref": "#/$defs/exactRef"
        },
        "continuationRef": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "rendering": {
          "const": "PRIMARY_TEXT_WITH_JSON_CONTEXT"
        },
        "primaryTextPointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "conversationTextPointer": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "contextPointers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "context": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "position": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 80
            }
          }
        }
      }
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "requireEvidenceCitations",
        "sources",
        "validatorRefs"
      ],
      "properties": {
        "requirement": {
          "enum": [
            "NONE",
            "WHEN_CAPABILITY_USED",
            "REQUIRED"
          ]
        },
        "requireEvidenceCitations": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/groundingSource"
          }
        },
        "validatorRefs": {
          "$ref": "#/$defs/exactRefList"
        }
      }
    },
    "groundingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "minimumCount"
      ],
      "properties": {
        "type": {
          "enum": [
            "READ_ACTION",
            "VECTOR_SPACE",
            "ANY_ALLOWED_VECTOR_SPACE",
            "ANY_REQUESTABLE_READ_ACTION"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "minimumCount": {
          "type": "integer",
          "minimum": 1
        },
        "requiredEvidenceIds": {
          "$ref": "#/$defs/nameList"
        },
        "groundingUsable": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "schemaRef",
        "finalValidatorRefs"
      ],
      "properties": {
        "mode": {
          "enum": [
            "DIRECT_PROJECTION",
            "STRUCTURED_GENERATION"
          ]
        },
        "schemaRef": {
          "$ref": "#/$defs/exactRef"
        },
        "directProjectorRef": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "conversationTextPointer": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "finalValidatorRefs": {
          "$ref": "#/$defs/exactRefList"
        },
        "normalizerRef": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "DIRECT_PROJECTION"
              }
            }
          },
          "then": {
            "required": [
              "directProjectorRef"
            ],
            "properties": {
              "directProjectorRef": {
                "$ref": "#/$defs/exactRef"
              }
            }
          },
          "else": {
            "properties": {
              "directProjectorRef": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "recordValidatedTurns"
      ],
      "properties": {
        "binding": {
          "enum": [
            "DISABLED",
            "OPTIONAL",
            "REQUIRED"
          ]
        },
        "recordValidatedTurns": {
          "type": "boolean"
        },
        "interactionCapability": {
          "enum": [
            "NON_INTERACTIVE",
            "DIALOGUE_CAPABLE"
          ],
          "default": "NON_INTERACTIVE"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDuration",
        "maxInputCharacters",
        "maxGroundingCharacters",
        "maxEvidenceReferences",
        "maxOutputCharacters",
        "maxOutputTokens"
      ],
      "properties": {
        "maxDuration": {
          "type": "string",
          "pattern": "^P(?!$).+$"
        },
        "maxInputCharacters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxGroundingCharacters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxEvidenceReferences": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maxOutputCharacters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
      }
    },
    "jsonPointer": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^(?:|(?:/(?:[^~/]|~[01])*)+)$"
    },
    "specialistChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": {"const": "ai.fabric/v1"},
        "kind": {"const": "SpecialistChain"},
        "metadata": {"$ref": "#/$defs/specialistMetadata"},
        "spec": {"$ref": "#/$defs/specialistChainSpec"}
      }
    },
    "specialistChainSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "manager",
        "targets",
        "limits",
        "conversationPolicy"
      ],
      "properties": {
        "input": {"$ref": "#/$defs/specialistChainInput"},
        "manager": {"$ref": "#/$defs/specialistChainManager"},
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/specialistChainTarget"}
        },
        "limits": {"$ref": "#/$defs/specialistChainLimits"},
        "conversationPolicy": {
          "enum": ["DISABLED", "OPTIONAL", "REQUIRED"]
        }
      }
    },
    "specialistChainInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaRef",
        "managerMessagePointer",
        "managerContext"
      ],
      "properties": {
        "schemaRef": {"$ref": "#/$defs/exactRef"},
        "managerMessagePointer": {"$ref": "#/$defs/jsonPointer"},
        "managerContext": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/specialistChainContextValue"}
        }
      }
    },
    "specialistChainContextValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "valuePointer"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,99}$"
        },
        "valuePointer": {"$ref": "#/$defs/jsonPointer"},
        "required": {"type": "boolean", "default": true}
      }
    },
    "specialistChainManager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specialistRef"],
      "properties": {
        "specialistRef": {"$ref": "#/$defs/exactRef"}
      }
    },
    "specialistChainTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specialistRef",
        "description",
        "input",
        "result",
        "transitions"
      ],
      "properties": {
        "specialistRef": {"$ref": "#/$defs/exactRef"},
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "input": {"$ref": "#/$defs/specialistChainTargetInput"},
        "result": {"$ref": "#/$defs/specialistChainTargetResult"},
        "transitions": {"$ref": "#/$defs/specialistChainTransitions"}
      }
    },
    "specialistChainTargetInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "fields"],
      "properties": {
        "type": {"const": "JSON_POINTER_MAP"},
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/specialistChainMappingField"}
        }
      }
    },
    "specialistChainMappingField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "targetField"],
      "properties": {
        "source": {"enum": ["CHAIN_INPUT", "MANAGER_OBJECTIVE"]},
        "sourcePointer": {"$ref": "#/$defs/jsonPointer"},
        "targetField": {
          "type": "string",
          "pattern": "^(?!(?:__proto__|constructor|prototype)$)[A-Za-z][A-Za-z0-9_-]{0,99}$"
        },
        "required": {"type": "boolean", "default": true}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "CHAIN_INPUT"}}},
          "then": {"required": ["sourcePointer"]},
          "else": {"not": {"required": ["sourcePointer"]}}
        }
      ]
    },
    "specialistChainTargetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "summaryPointer",
        "facts",
        "evidenceReferences"
      ],
      "properties": {
        "type": {"const": "BOUNDED_FACT_PROJECTION"},
        "summaryPointer": {"$ref": "#/$defs/jsonPointer"},
        "facts": {
          "type": "array",
          "maxItems": 24,
          "items": {"$ref": "#/$defs/specialistChainFact"}
        },
        "evidenceReferences": {"enum": ["NONE", "ALL_APPROVED"]}
      }
    },
    "specialistChainFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "valuePointer"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "valuePointer": {"$ref": "#/$defs/jsonPointer"},
        "required": {"type": "boolean", "default": true}
      }
    },
    "specialistChainTransitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegationAllowed",
        "parallelEligible",
        "handoffAllowed"
      ],
      "properties": {
        "delegationAllowed": {"type": "boolean"},
        "parallelEligible": {"type": "boolean"},
        "handoffAllowed": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"parallelEligible": {"const": true}}},
          "then": {"properties": {"delegationAllowed": {"const": true}}}
        },
        {
          "anyOf": [
            {"properties": {"delegationAllowed": {"const": true}}},
            {"properties": {"handoffAllowed": {"const": true}}}
          ]
        }
      ]
    },
    "specialistChainLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDuration",
        "maxManagerDecisions",
        "maxWorkerInvocations",
        "maxParallelWorkers",
        "maxInvocationsPerTarget",
        "maxProjectedResultCharacters"
      ],
      "properties": {
        "maxDuration": {"type": "string", "minLength": 3, "maxLength": 40},
        "maxManagerDecisions": {"type": "integer", "minimum": 2},
        "maxWorkerInvocations": {"type": "integer", "minimum": 1},
        "maxParallelWorkers": {"type": "integer", "minimum": 1},
        "maxInvocationsPerTarget": {"const": 1},
        "maxProjectedResultCharacters": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "schemaResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "const": "ai.fabric/v1"
        },
        "kind": {
          "const": "SpecialistSchema"
        },
        "metadata": {
          "$ref": "#/$defs/resourceMetadata"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direction",
            "draft",
            "schema"
          ],
          "properties": {
            "direction": {
              "enum": [
                "INPUT",
                "OUTPUT"
              ]
            },
            "draft": {
              "const": "2020-12"
            },
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "promptProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "const": "ai.fabric/v1"
        },
        "kind": {
          "const": "SpecialistPromptProfile"
        },
        "metadata": {
          "$ref": "#/$defs/resourceMetadata"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "constraints",
            "outputContract"
          ],
          "properties": {
            "constraints": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "outputContract": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          }
        }
      }
    }
  }
}
