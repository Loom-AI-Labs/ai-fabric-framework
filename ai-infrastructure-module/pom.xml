    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ai.fabric</groupId>
    <artifactId>ai-fabric-bom</artifactId>
    <version>0.1.0-preview</version>
    <packaging>pom</packaging>

    <name>AI Fabric Framework BOM</name>
    <description>Open-source AI Fabric Framework for Spring Boot applications with orchestration, RAG, actions, providers, and vector integration</description>
    <url>https://github.com/mahmoudashraf/ai-fabric-framework</url>

    <scm>
        <connection>scm:git:https://github.com/mahmoudashraf/ai-fabric-framework.git</connection>
        <developerConnection>scm:git:https://github.com/mahmoudashraf/ai-fabric-framework.git</developerConnection>
        <url>https://github.com/mahmoudashraf/ai-fabric-framework</url>
        <tag>HEAD</tag>
    </scm>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>ai-infrastructure-core</module>
        <module>ai-infrastructure-actions-connector</module>
        <module>ai-infrastructure-actions-registry</module>
        <module>ai-infrastructure-actions-registry-liquibase</module>
