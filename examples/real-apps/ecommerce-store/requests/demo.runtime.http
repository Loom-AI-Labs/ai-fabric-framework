### AI Fabric Runtime + Customer Connector — local demo requests
@runtimeBaseUrl = http://localhost:8097
@connectorBaseUrl = http://localhost:8096
@userId = user-1
@sessionId = user-1-session
@conversationId = chat-user-1

### Health (Runtime)
GET {{runtimeBaseUrl}}/actuator/health

### Swagger UI (open in browser)
# Runtime: {{runtimeBaseUrl}}/swagger-ui/index.html
# Connector: {{connectorBaseUrl}}/swagger-ui/index.html

### Data Sync: list vector spaces
GET {{runtimeBaseUrl}}/api/ai/data-sync/vector-spaces

### Runtime vector probe: raw AI Fabric search results from pushed data
GET {{runtimeBaseUrl}}/api/runtime/vector-search?vectorSpace=product&q=wireless%20headphones&limit=5&threshold=0

### NOTE
# Local no-key runtime:
#   java -jar ../chat-capabilities-demo/target/chat-capabilities-demo-1.0.0-SNAPSHOT.jar --spring.profiles.active=smoke
#
# Real provider runtime:
#   export OPENAI_ENABLED=true
#   export OPENAI_API_KEY="..."
#   export OPENAI_EMBEDDING_DIMENSIONS=512

### Data Sync: upsert product SKU-0001 into vector space "product"
POST {{runtimeBaseUrl}}/api/ai/data-sync/upsert
Content-Type: application/json

{
  "vectorSpace": "product",
  "id": "SKU-0001",
  "entity": {
    "sku": "SKU-0001",
    "name": "Premium Wireless Headphones",
    "description": "Noise-cancelling over-ear headphones with 30h battery life. Great for travel and office use.",
    "category": "Headphones",
    "tags": "wireless,noise-cancelling,audio",
    "price": 199.99,
    "currency": "USD",
    "inStockQty": 25
  },
  "trace": {
    "requestId": "seed-1",
    "metadata": { "source": "manual-demo", "operation": "product-upsert" },
    "authContext": {
      "subjectId": "system:platform-ecommerce-store",
      "subjectType": "SYSTEM_PROCESS",
      "authMode": "PRIVATE_RUNTIME_BACKEND_MEDIATED",
      "callerType": "SYSTEM_PROCESS",
      "sessionId": "seed-session",
      "deploymentId": "ecommerce-store-local",
      "customerId": "demo-commerce-customer",
      "tenantId": "demo-commerce-tenant",
      "issuer": "platform-ecommerce-store",
      "grantedScopes": ["data-sync:upsert", "data-sync:delete"]
    }
  }
}

