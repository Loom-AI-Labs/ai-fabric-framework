<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.ai.fabric.examples</groupId>
    <artifactId>smoke-support</artifactId>
    <version>0.3.3</version>
    <name>AI Fabric Real Apps :: Smoke Support</name>
    <description>Shared offline deterministic providers that let the example apps boot under the "smoke"
        profile with no API keys or external services.</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <ai-fabric.version>0.3.3</ai-fabric.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.loom-ai-labs</groupId>
            <artifactId>ai-fabric-core</artifactId>
            <version>${ai-fabric.version}</version>
        </dependency>
        <!-- Local in-memory vector store selected by application-smoke.yml (ai.vector-db.type=memory),
             so apps that otherwise bundle Lucene/Qdrant can still satisfy VectorDatabaseService offline. -->
        <dependency>
            <groupId>io.github.loom-ai-labs</groupId>
            <artifactId>ai-fabric-vector-memory</artifactId>
            <version>${ai-fabric.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- In-memory H2 so apps wired to an external DB (e.g. Postgres) can boot under the smoke profile. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
