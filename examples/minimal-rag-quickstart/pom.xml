<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Empty relativePath keeps this example independent of the AI Fabric reactor. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>dev.aifabric.examples</groupId>
    <artifactId>minimal-rag-quickstart</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>AI Fabric minimal RAG quickstart</name>
    <description>Standalone semantic retrieval example using AI Fabric from Maven Central</description>

    <properties>
        <java.version>21</java.version>
        <ai-fabric.version>0.3.3</ai-fabric.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.loom-ai-labs</groupId>
            <artifactId>ai-fabric-vector-lucene</artifactId>
            <version>${ai-fabric.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
